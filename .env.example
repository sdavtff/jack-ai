PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
COOKIE_SECURE=false
# Chave do OpenRouter com créditos. Todos os modelos do catálogo são pagos e cobrados por token.
# Dica: defina um limite de gastos na própria chave (openrouter.ai/settings/keys).
OPENROUTER_API_KEY=

# Login com Google (opcional). Passo a passo em GOOGLE_LOGIN.md. Sem as duas chaves, o botão não aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Endereço público do site, sem barra no final (ex.: https://jackai.discloud.dev). Vazio: usa o endereço
# em que o site foi aberto. O retorno do Google é PUBLIC_URL/api/auth/google/callback.
PUBLIC_URL=

# Catálogo de modelos (models.config.mjs). Todos opcionais.
# Rotas do Jack AI Pro em ordem de preferência, separadas por vírgula. Vazio usa o padrão do catálogo.
JACK_PRO_ROUTES=
# Quem pode usar o Jack AI Pro: account (somente contas) ou guest (inclui visitantes). Padrão: account.
JACK_PRO_ACCESS=account
# Quem pode criar imagens com o Jack AI Imagem: account (somente contas) ou guest (inclui visitantes). Padrão: account.
# Cada imagem é cobrada pelo OpenRouter, por isso o padrão exige conta.
JACK_IMAGE_ACCESS=account
# Desativa modelos sem editar telas, por exemplo: jack/studio,openrouter/openai/gpt-6-astra-pro
JACK_DISABLED_MODELS=
# Chamada mínima automática (até 16 tokens, cobrada) antes de liberar cada rota do catálogo: on ou off. Padrão: on.
JACK_ROUTE_CHECKS=on
